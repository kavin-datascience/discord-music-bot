# Rename this file to .env and fill in your own values.
# NEVER share this file or commit it to GitHub.
#
# IMPORTANT: if you previously had a filled-in "_env" or ".env" file that left
# your machine (uploaded somewhere, screenshotted, pushed to a repo, etc.),
# reset your bot token in the Discord Developer Portal before using it here.

DISCORD_TOKEN=
CLIENT_ID=

# Lavalink connection info (must match application.yml)
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

# Only needed if you want /play to also accept "guild-only 24/7" style behavior
# to survive restarts — not required for basic Spotify search/links.
